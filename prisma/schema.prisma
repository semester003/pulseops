generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  ADMIN
  RESPONDER
  VIEWER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String
  displayName          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organizationMembers  OrganizationMember[]
  teamMembers          TeamMember[]
  onCallMemberships    OnCallMember[]
  currentIncidents     Incident[]           @relation("CurrentResponder")
  acknowledgedIncidents Incident[]          @relation("AcknowledgedBy")
  resolvedIncidents    Incident[]           @relation("ResolvedBy")
  notifications        NotificationDelivery[]
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  teams       Team[]
  services    Service[]
  incidents   Incident[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
}

model Team {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members          TeamMember[]
  services         Service[]
  onCallSchedule   OnCallSchedule?
  escalationPolicy EscalationPolicy?
  incidents        Incident[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Service {
  id             String     @id @default(cuid())
  organizationId String
  teamId         String
  name           String
  description    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  incidents      Incident[]

  @@unique([organizationId, name])
  @@index([organizationId, teamId])
}

model OnCallSchedule {
  id                      String         @id @default(cuid())
  teamId                  String         @unique
  rotationStartAt         DateTime       @default(now())
  rotationPeriodMinutes   Int            @default(1440)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  team                    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members                 OnCallMember[]
}

model OnCallMember {
  id          String         @id @default(cuid())
  scheduleId  String
  userId      String
  position    Int
  createdAt   DateTime       @default(now())
  schedule    OnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, userId])
  @@unique([scheduleId, position])
  @@index([scheduleId, position])
}

model EscalationPolicy {
  id                        String   @id @default(cuid())
  teamId                    String   @unique
  acknowledgementTimeoutMin Int
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  team                      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Incident {
  id                 String           @id @default(cuid())
  organizationId     String
  serviceId          String
  teamId             String
  title              String
  description        String?
  severity           IncidentSeverity
  status             IncidentStatus   @default(TRIGGERED)
  currentResponderId String?
  escalationStep     Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  acknowledgedById   String?
  resolvedById       String?
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service            Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  team               Team             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  currentResponder   User?            @relation("CurrentResponder", fields: [currentResponderId], references: [id], onDelete: SetNull)
  acknowledgedBy     User?            @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy         User?            @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  deliveries         NotificationDelivery[]

  @@index([organizationId, createdAt])
  @@index([serviceId, status])
  @@index([teamId, status])
  @@index([status, updatedAt])
}

model NotificationDelivery {
  id          String         @id @default(cuid())
  incidentId  String
  recipientId String
  step        Int
  status      DeliveryStatus @default(PENDING)
  attemptCount Int            @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  recipient   User           @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([incidentId, step])
  @@index([status, updatedAt])
}
